# Copy this file to .env at the repo root and fill in real values.
# .env is gitignored — never commit real secrets (see byteplus_ark.py header).
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# BytePlus ModelArk (Seedream 5.0 Pro / Seedance 2.5 / Seed 2.1)
# Required by byteplus_ark.py and QA_checklist.py --live mode.
# ---------------------------------------------------------------------------
ARK_API_KEY=ark-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Gemini API used by fetch_tiktok_url/agent.py
GEMINI_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------------
# Backend (FastAPI) — see backend/app/core/config.py
# ---------------------------------------------------------------------------
PROJECT_NAME="Tho Cot Commerce Campaign Copilot"
API_V1_STR=/api
ENVIRONMENT=production
DEBUG=false

# Comma-separated or JSON array list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000","http://frontend:3000"]

# Relational DB used by the Items demo feature only.
DATABASE_URL=sqlite:///./sql_app.db

# Host path mounted into the backend container as /app/data
BACKEND_DATA_DIR=./backend/data

# Port the backend container listens on / is published on
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Frontend (Next.js) — see frontend/src/lib (API client)
# ---------------------------------------------------------------------------
# Base URL the browser/client uses to reach the backend API.
# frontend/src/lib/api.ts appends endpoint paths directly (e.g. "/health"),
# so this must include the "/api" prefix used by the FastAPI router.
# When routed through the nginx reverse proxy, this can be "/api".
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Port the frontend container listens on / is published on
FRONTEND_PORT=3000

# ---------------------------------------------------------------------------
# Nginx reverse proxy
# ---------------------------------------------------------------------------
NGINX_PORT=80
