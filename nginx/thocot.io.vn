# Host nginx config (installed at /etc/nginx/sites-enabled/thocot.io.vn on the VPS).
# Terminates TLS and reverse-proxies to the Docker containers started by
# docker-compose.yml (backend on host port 8000, frontend on host port 3002).
#
# Deploy with:
#   sudo cp nginx/thocot.io.vn /etc/nginx/sites-enabled/thocot.io.vn
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name thocot.io.vn www.thocot.io.vn;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name thocot.io.vn www.thocot.io.vn;

    ssl_certificate     /etc/letsencrypt/live/thocot.io.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/thocot.io.vn/privkey.pem;

    client_max_body_size 20M;

    # Next.js frontend (docker-compose service "frontend", published on
    # host port 3002 — see FRONTEND_PORT in .env).
    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        proxy_connect_timeout 1000s;
        proxy_send_timeout    1000s;
        proxy_read_timeout    1000s;
    }

    # FastAPI backend Swagger UI / ReDoc (docs_url="/docs", redoc_url="/redoc"
    # in app/main.py — these are NOT under the /api prefix, unlike the rest
    # of the API). Proxied to the same backend container as /api/ below.
    location ~ ^/(docs|redoc)$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # FastAPI backend (docker-compose service "backend", published on host
    # port 8000 — see BACKEND_PORT in .env). The app itself is mounted under
    # the "/api" prefix (see API_V1_STR in backend/.env), so the prefix is
    # forwarded as-is — no trailing slash on proxy_pass, no path stripping.
    # This also covers /api/openapi.json, which Swagger UI at /docs fetches.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        proxy_connect_timeout 1000s;
        proxy_send_timeout    1000s;
        proxy_read_timeout    1000s;
    }

    # Generated studio assets (app/main.py mounts StaticFiles at "/media",
    # a sibling of "/api" rather than a child of it — see
    # backend/app/services/studio/config.py's DATA_DIR and studio.py's
    # _to_url, which rewrite every generated image/video path to
    # "/media/...". Without this block those requests fall through to the
    # catch-all `location /` above and hit the frontend container instead
    # of the backend, which is why generated images/video rendered as
    # broken-image icons in the studio graph — the URL 404'd against
    # Next.js rather than reaching FastAPI's StaticFiles mount.
    location /media/ {
        proxy_pass http://127.0.0.1:8000/media/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 1000s;
        proxy_send_timeout    1000s;
        proxy_read_timeout    1000s;
    }

    # Static pitch deck (presentation-package/ at the repo root — see its own
    # DEPLOY.txt). Not part of the Docker app: this is a self-contained static
    # HTML bundle, served straight from disk rather than proxied to either
    # container. Deploy by copying the folder's contents to
    # /var/www/thocot-slide/ on the VPS (keep assets-gen/ and frontend/
    # subfolders intact, exactly as DEPLOY.txt requires — presentation.html
    # references them by relative path, e.g. "frontend/public/sponsors/...",
    # "assets-gen/.../master_15s.mp4", so they resolve under
    # /slide/frontend/... and /slide/assets-gen/... once nginx serves this
    # whole directory at /slide/).
    #
    #   sudo mkdir -p /var/www/thocot-slide
    #   sudo cp -r presentation-package/. /var/www/thocot-slide/
    #   sudo chown -R www-data:www-data /var/www/thocot-slide
    #
    # Deliberately not /root/temp/: /root is 700 by default (root-only
    # traversal), and nginx's worker runs as www-data/nginx, not root — every
    # request under /root/temp/ would 403 until that directory's permissions
    # were loosened by hand. /var/www/ is the standard, no-fuss location for
    # static content nginx already expects to read.
    location /slide/ {
        alias /var/www/thocot-slide/;
        index presentation.html;

        # DEPLOY.txt: "Support byte-range requests for smooth MP4 seeking" —
        # on by default for static files, named here so it's not accidentally
        # turned off if this block is ever wrapped in a proxy-style location.
        aio threads;
        sendfile on;
    }

    # /slide (no trailing slash) -> /slide/, so the bare URL the deck is meant
    # to be shared as also resolves instead of 404ing on a missing slash.
    location = /slide {
        return 301 /slide/;
    }
}
